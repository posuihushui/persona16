# ---- 基础 ----
# 站点对外地址，用于分享链接和支付回调，生产必须是已备案的 https 域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ---- 数据库 ----
DATABASE_URL="mysql://root:password@localhost:3306/persona16"

# ---- 会话 ----
# 用于签名匿名 sessionKey Cookie，生产必须是随机 32 字节以上的值
SESSION_SECRET=replace-me-with-a-long-random-string

# ---- 支付 ----
# mock 仅用于本地开发。生产必须是 wechat，check:prod-env 会拦截 mock。
PAY_PROVIDER=mock

# 微信支付（生产必填）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL_NO=
# 商户私钥 PEM 内容，注意换行用 \n 转义
WECHAT_MCH_PRIVATE_KEY=
# 平台公钥按 Wechatpay-Serial 映射，格式 serial1=PEM;;serial2=PEM
WECHAT_PLATFORM_PUBLIC_KEYS=
WECHAT_PAY_NOTIFY_URL=

# ---- SEO 与站长平台，可选，未配置时不输出对应 meta ----
BAIDU_SITE_VERIFICATION=
BYTEDANCE_SITE_VERIFICATION=
SOGOU_SITE_VERIFICATION=
SHENMA_SITE_VERIFICATION=
QIHOO_SITE_VERIFICATION=
HUAWEI_SITE_VERIFICATION=
# 百度搜索资源平台的普通收录 token，用于 npm run seo:ping
BAIDU_PUSH_TOKEN=
# IndexNow 密钥，同时要把 <key>.txt 放到 public/
INDEXNOW_KEY=

# ---- 法务与客服，结果页与协议页展示，check:prod-env 会校验非占位 ----
LEGAL_ENTITY_NAME=
LEGAL_ICP_NUMBER=
LEGAL_CONTACT_EMAIL=
LEGAL_REFUND_WINDOW_DAYS=7
