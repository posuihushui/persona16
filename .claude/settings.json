{
  "permissions": {
    "allow": [
      "Bash(npm run check:content)",
      "Bash(npm run check:compliance)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma validate)",
      "Bash(node scripts/*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.production)",
      "Read(./certs/**)"
    ]
  }
}
